{
  "agent": "qoder-main-default",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=\"$(git rev-parse --show-toplevel)\" && exec \"$root/.qoder/hooks/session-start.sh\"'",
            "timeout": 30
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=\"$(git rev-parse --show-toplevel)\" && exec \"$root/.qoder/hooks/cwd-changed.sh\"'",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=\"$(git rev-parse --show-toplevel)\" && exec \"$root/.qoder/hooks/user-prompt-submit.sh\"'",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=\"$(git rev-parse --show-toplevel)\" && exec \"$root/.qoder/hooks/pre_tool_bootstrap.sh\"'",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=\"$(git rev-parse --show-toplevel)\" && exec \"$root/.qoder/hooks/pre_tool_guard.sh\"'",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|apply_patch|ApplyPatch",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=\"$(git rev-parse --show-toplevel)\" && exec \"$root/.qoder/hooks/pre_write_guard.sh\"'",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=\"$(git rev-parse --show-toplevel)\" && exec \"$root/.qoder/hooks/post_bash_guard.sh\"'",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|apply_patch|ApplyPatch",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=\"$(git rev-parse --show-toplevel)\" && exec \"$root/.qoder/hooks/post_tool_guard.sh\"'",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=\"$(git rev-parse --show-toplevel)\" && exec \"$root/.qoder/hooks/tool_failure.sh\"'",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=\"$(git rev-parse --show-toplevel)\" && exec \"$root/.qoder/hooks/stop_check.sh\"'",
            "timeout": 1500
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=\"$(git rev-parse --show-toplevel)\" && exec \"$root/.qoder/hooks/stop_failure.sh\"'",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=\"$(git rev-parse --show-toplevel)\" && exec \"$root/.qoder/hooks/session_end.sh\"'",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
