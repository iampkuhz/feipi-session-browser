{
  "_comment": "示例文件：复制到 .claude/settings.local.json 作为个人本地覆盖。此文件可安全提交，不包含真实本地路径。",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/ABSOLUTE/PATH/TO/YOUR/LOCAL/WORKSPACE"
    ],
    "allow": [],
    "ask": [],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(.mcp.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(chmod -R 777 /:*)",
      "Bash(dd if=* of=/dev/*)"
    ]
  },
  "notes": "将 /ABSOLUTE/PATH/TO/YOUR/LOCAL/WORKSPACE 替换为你自己的本地工作区绝对路径。不要提交包含真实路径的版本。",
  "do_not_commit_real_local_paths": true
}
