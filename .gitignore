# 路径约定：/ 开头限定仓库根目录，/ 结尾表示目录，! 表示显式保留。
# 白名单紧跟对应的忽略规则；无路径前缀的文件名与扩展名规则匹配任意层级。

# ── 系统与编辑器 ──
.DS_Store
/.idea/
/.vscode/

# ── 个人配置与环境变量 ──
/.claude/settings.local.json
/.qoder/
.mcp.json
.env

# ── 本地运行数据、工具缓存与报告 ──
.local/
/data/
/output/
/tmp/*
/harness/reports/
/java/tests/playwright/test-results/
# PlantUML 源码保存在 Markdown 中，图包为生成产物。
/docs/gates/diagrams/

# ── Python 生成文件 ──
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ── SQLite 本地索引 ──
*.sqlite
*.sqlite3

# ── Node / Playwright 依赖 ──
/java/tests/playwright/node_modules/

# ── Gradle 构建产物 ──
/java/**/build/
/java/gradle/build-logic/build/
/java/gradle/build-logic/.gradle/

# ── OpenSpec 本地变更状态 ──
/openspec/active_change.json
/openspec/changes/

# ── 客户端运行状态 ──
/.claude/worktrees/
